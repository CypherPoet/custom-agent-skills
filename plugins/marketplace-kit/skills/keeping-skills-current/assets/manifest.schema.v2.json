                    "category",
                    "summary",
                    "target",
                    "sources",
                    "proposedAction"
                  ],
                  "type": "object"
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "details",
                "reason",
                "decidedAt"
              ],
              "type": "object"
            },
            "type": "array"
          },
