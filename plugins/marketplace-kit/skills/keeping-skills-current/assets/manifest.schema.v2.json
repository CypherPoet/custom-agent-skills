            },
            "type": "object"
          },
          "state": {
            "additionalProperties": false,
            "properties": {
              "inputFingerprint": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "lastAttemptStatus": {
                "enum": [
                  "completed",
                  "incomplete"
                ]
              },
              "lastAttemptedReview": {
                "format": "date-time",
                "type": "string"
              },
              "lastCompletedReview": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "lastAttemptedReview",
              "lastAttemptStatus"
            ],
            "type": "object"
          }
        },
        "required": [
          "path",
          "schedule",
          "sources",
          "deferredFindings",
          "declinedFindings"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": "object"
