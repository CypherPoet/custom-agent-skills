{
  "$id": "https://cypherpoet.dev/schemas/keeping-skills-current/manifest.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changeValidation": {
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "delivery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "correctionStrategy": {
              "enum": [
                "reportOnly",
                "applyHighConfidenceCorrections"
              ]
            },
            "reportPath": {
              "minLength": 1,
              "type": "string"
            },
            "strategy": {
              "const": "localReport"
            }
          },
          "required": [
            "strategy",
            "reportPath",
            "correctionStrategy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "autoMergeStrategy": {
              "enum": [
                "none",
                "stateOnly"
              ]
            },
            "branchName": {
              "minLength": 1,
              "type": "string"
            },
            "fallbackReportPath": {
              "minLength": 1,
              "type": "string"
            },
            "strategy": {
              "const": "githubPullRequest"
            }
          },
          "required": [
            "strategy",
            "branchName",
            "autoMergeStrategy"
          ],
          "type": "object"
        }
      ]
    },
    "scheduler": {
      "enum": [
        "none",
        "agentPlatform",
        "githubActions"
      ]
    },
    "schemaVersion": {
      "const": 2
    },
    "skills": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "declinedFindings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "decidedAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "details": {
                  "additionalProperties": false,
                  "properties": {
                    "category": {
                      "enum": [
                        "correction",
                        "improvementSuggestion",
                        "humanDecision"
                      ]
                    },
                    "proposedAction": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "sources": {
                      "additionalProperties": {
                        "additionalProperties": false,
                        "properties": {
                          "retrieval": {
                            "oneOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "strategy": {
                                    "const": "page"
                                  }
                                },
                                "required": [
                                  "strategy"
                                ],
                                "type": "object"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "excludePaths": {
                                    "items": {
                                      "pattern": "^/",
                                      "type": "string"
                                    },
                                    "type": "array",
                                    "uniqueItems": true
                                  },
                                  "includePaths": {
                                    "items": {
                                      "pattern": "^/",
                                      "type": "string"
                                    },
                                    "minItems": 1,
                                    "type": "array",
                                    "uniqueItems": true
                                  },
                                  "maxDepth": {
                                    "maximum": 5,
                                    "minimum": 1,
                                    "type": "integer"
                                  },
                                  "maxPages": {
                                    "maximum": 100,
                                    "minimum": 1,
                                    "type": "integer"
                                  },
                                  "strategy": {
                                    "const": "crawl"
                                  }
                                },
                                "required": [
                                  "strategy",
                                  "includePaths",
                                  "maxDepth",
                                  "maxPages"
                                ],
                                "type": "object"
                              }
                            ]
                          },
                          "url": {
                            "format": "uri",
                            "pattern": "^https://",
                            "type": "string"
                          }
                        },
                        "required": [
                          "url",
                          "retrieval"
                        ],
                        "type": "object"
                      },
                      "minProperties": 1,
                      "propertyNames": {
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "type": "object"
                    },
                    "summary": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "target": {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "not": {
                            "required": [
                              "anchorText"
                            ]
                          },
                          "properties": {
                            "anchorText": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "currentText": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "filePath": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "filePath",
                            "currentText"
                          ],
                          "type": "object"
                        },
                        {
