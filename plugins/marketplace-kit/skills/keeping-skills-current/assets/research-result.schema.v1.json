{
  "$id": "https://cypherpoet.dev/schemas/keeping-skills-current/research-result.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stage",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "correction",
                  "improvementSuggestion",
                  "humanDecision"
                ]
              },
              "proposedAction": {
                "minLength": 1,
                "type": "string"
              },
              "sources": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {
                    "retrieval": {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "strategy": {
                              "const": "page"
                            }
                          },
                          "required": [
                            "strategy"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "excludePaths": {
                              "items": {
                                "pattern": "^/",
                                "type": "string"
                              },
                              "type": "array",
                              "uniqueItems": true
                            },
                            "includePaths": {
                              "items": {
                                "pattern": "^/",
                                "type": "string"
                              },
                              "minItems": 1,
                              "type": "array",
                              "uniqueItems": true
                            },
                            "maxDepth": {
                              "maximum": 5,
                              "minimum": 1,
                              "type": "integer"
                            },
                            "maxPages": {
                              "maximum": 100,
                              "minimum": 1,
                              "type": "integer"
                            },
                            "strategy": {
                              "const": "crawl"
                            }
                          },
                          "required": [
                            "strategy",
                            "includePaths",
                            "maxDepth",
                            "maxPages"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "url": {
                      "format": "uri",
                      "pattern": "^https://",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "retrieval"
                  ],
                  "type": "object"
                },
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "type": "object"
              },
              "summary": {
                "minLength": 1,
                "type": "string"
              },
              "target": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "not": {
                      "required": [
                        "anchorText"
                      ]
                    },
                    "properties": {
                      "anchorText": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "currentText": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "filePath": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "filePath",
                      "currentText"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "not": {
                      "required": [
                        "currentText"
                      ]
                    },
                    "properties": {
                      "anchorText": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "currentText": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "filePath": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "filePath",
                      "anchorText"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": [
              "category",
              "summary",
              "target",
              "sources",
              "proposedAction"
            ],
            "type": "object"
          },
          "editDisposition": {
            "enum": [
              "applied",
              "proposed",
              "revertedAfterValidationFailure",
              "notApplicable"
            ]
          },
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidencePageUrl": {
                  "format": "uri",
                  "type": "string"
                },
                "excerpt": {
                  "minLength": 1,
                  "type": "string"
                },
                "sourceId": {
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "type": "string"
                },
                "sourceRootUrl": {
                  "format": "uri",
                  "type": "string"
                },
                "summary": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "sourceRootUrl",
                "evidencePageUrl",
                "summary",
                "excerpt"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "details",
          "evidence",
          "editDisposition"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "projectIdentity": {
      "minLength": 1,
      "type": "string"
    },
    "reviewedAt": {
      "format": "date-time",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "skillId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "skillPath": {
      "minLength": 1,
      "type": "string"
    },
    "sourceOutcomes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attemptedPages": {
            "minimum": 0,
            "type": "integer"
          },
          "failureReason": {
            "type": "string"
          },
          "failureStage": {
            "type": "string"
          },
          "limitReached": {
            "type": "boolean"
          },
          "rootUrl": {
            "format": "uri",
            "type": "string"
          },
          "sourceId": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "status": {
            "enum": [
              "retrieved",
              "missing",
              "failed"
            ]
          },
          "successfulPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sourceId",
          "rootUrl",
          "status",
          "successfulPages",
          "attemptedPages",
          "limitReached"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "incomplete"
      ]
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped"
                ]
              }
            },
            "required": [
              "name",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "notApplicable"
          ]
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "projectIdentity",
    "skillId",
    "skillPath",
    "reviewedAt",
    "status",
    "sourceOutcomes",
    "findings",
    "failures",
    "validation"
  ],
  "title": "Keeping Skills Current Research Result",
  "type": "object"
}
