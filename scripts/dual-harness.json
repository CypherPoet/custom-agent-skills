{
  "_comment": "Single source of truth for dual-harness (Claude Code + Codex) generation. Run scripts/sync_dual_harness.py --write to regenerate every derived artifact; --check to fail on drift. Never hand-edit generated files: .codex-plugin/plugin.json, .agents/plugins/marketplace.json, or any vendored skill copy.",

  "codex_marketplace": {
    "name": "cypherpoet-marketplace",
    "output": ".agents/plugins/marketplace.json"
  },

