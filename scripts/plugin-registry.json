{
  "_comment": "The plugin registry: harness targeting, Codex presentation metadata, and skill-sharing (vendoring) edges. Run npm run sync to regenerate every derived artifact; run npm run sync:check to fail on drift. Never hand-edit generated files: any .codex-plugin/plugin.json or vendored skill copy. Categories also feed Codex catalog entries in the cypherpoet-toolchest marketplace repo; interface metadata stays in generated plugin manifests.",
  "vendored_skills": [
    {
      "source": "plugins/cypherpoet-webgl-kit/skills/webgl-mastery",
      "targets": [
        "plugins/cypherpoet-threejs-kit/skills/webgl-mastery",
        "plugins/cypherpoet-react-three-fiber-kit/skills/webgl-mastery"
      ]
    },
    {
      "source": "plugins/cypherpoet-threejs-kit/skills/threejs-mastery",
      "targets": [
        "plugins/cypherpoet-react-three-fiber-kit/skills/threejs-mastery"
      ]
    },
    {
      "source": "plugins/cypherpoet-apple-app-store-screenshots/skills/apple-app-store-screenshots",
      "targets": [
        "plugins/cypherpoet-mobile-dev/skills/apple-app-store-screenshots"
      ]
    },
    {
      "source": "plugins/cypherpoet-emoji-commits/skills/emoji-commits",
      "targets": [
        "plugins/cypherpoet-git-flow/skills/emoji-commits"
      ]
    },
    {
      "source": "plugins/cypherpoet-changelog-maintenance/skills/changelog-maintenance",
      "targets": [
        "plugins/cypherpoet-git-flow/skills/changelog-maintenance"
      ]
    },
    {
      "source": ".claude/skills/skill-structure-check",
      "targets": [
        ".agents/skills/skill-structure-check"
      ]
    }
  ],
  "dual_harness_plugins": {
    "cypherpoet-app-store-connect-kit": {
      "category": "Developer Tools",
      "interface": {
        "displayName": "App Store Connect",
        "shortDescription": "Manage Apple app releases",
        "capabilities": ["Interactive", "Read", "Write"],
        "defaultPrompt": ["Prepare this app for an App Store Connect submission."]
      }
    },
    "cypherpoet-apple-app-icons": {
      "category": "Creativity",
      "interface": {
        "displayName": "Apple App Icons",
        "shortDescription": "Design and audit Apple icons",
        "capabilities": ["Read", "Write"],
        "defaultPrompt": ["Audit this Apple app icon and recommend improvements."]
      }
    },
    "cypherpoet-apple-app-store-screenshots": {
      "category": "Developer Tools",
      "interface": {
        "displayName": "App Store Screenshots",
        "shortDescription": "Create App Store screenshots",
